class Solution {
public:
    int maxLength(vector<int>& nums) {
        int n = nums.size();
        int ans = min(n, 2);

        for (int i = 0; i < n; i++) {

            if (i + 2 >= n)
                break;

            bool valid = (gcd(nums[i], nums[i + 1]) == 1);

            for (int j = i + 2; j < n && valid; j++) {

                for (int k = i; k < j; k++) {

                    if (gcd(nums[k], nums[j]) != 1) {
                        valid = false;
                        break;
                    }
                }

                if (valid) {
                    ans = max(ans, j - i + 1);
                }
            }
        }

        return ans;
    }
};
