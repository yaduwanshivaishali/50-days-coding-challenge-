class Solution {
public:
    int numOfSubarrays(vector<int>& arr) {
        long long sum = 0, odd = 0, even = 1, ans = 0;
        int mod = 1e9 + 7;

        for(int x : arr) {
            sum += x;

            if(sum % 2 == 0) {
                ans += odd;
                even++;
            }
            else {
                ans += even;
                odd++;
            }

            ans %= mod;
        }

        return ans;
    }
};
