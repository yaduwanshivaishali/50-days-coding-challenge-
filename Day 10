class Solution {
public:
    int minimumChanges(string s, int k) {
        int n = s.size();
        const int INF = 1e9;

        vector<vector<int>> cost(n, vector<int>(n, INF));

        for (int len = 2; len <= n; len++) {
            for (int l = 0; l + len <= n; l++) {
                for (int d = 1; d < len; d++) {
                    if (len % d != 0) continue;

                    int changes = 0;
                    int m = len / d;

                    for (int r = 0; r < d; r++) {
                        for (int x = 0; x < m / 2; x++) {
                            int a = l + r + x * d;
                            int b = l + r + (m - 1 - x) * d;

                            if (s[a] != s[b])
                                changes++;
                        }
                    }

                    cost[l][l + len - 1] =
                        min(cost[l][l + len - 1], changes);
                }
            }
        }

        vector<vector<int>> dp(k + 1, vector<int>(n + 1, INF));
        dp[0][0] = 0;

        for (int p = 1; p <= k; p++) {
            for (int i = 2 * p; i <= n; i++) {
                for (int j = 2 * (p - 1); j <= i - 2; j++) {
                    dp[p][i] = min(dp[p][i],
                        dp[p - 1][j] + cost[j][i - 1]);
                }
            }
        }

        return dp[k][n];
    }
};
